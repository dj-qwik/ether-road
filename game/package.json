{
  "name": "@etherroad/game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ether Road game: deterministic simulation, browser client, and the authoritative multiplayer server.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node server/index.mjs",
    "test": "node tools/determinism.mjs 2 && node tools/nettest.mjs 1 4 --humans 2",
    "test:full": "node tools/determinism.mjs 6 && node tools/nettest.mjs 2 4 --humans 2 --lat 120 --jitter 60",
    "accept": "node tools/accept.mjs"
  },
  "dependencies": {
    "ws": "8.18.3",
    "viem": "^2.57.7",
    "@etherroad/shared": "*",
    "pg": "^8.13.0"
  }
}
