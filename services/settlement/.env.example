# ── Chain ── Start on testnet (46630). Mainnet is 4663.
CHAIN_ID=46630
# Dedicated provider recommended (Alchemy is Robinhood's recommended provider): https://robinhood-testnet.g.alchemy.com/v2/<KEY>
RPC_URL=https://rpc.testnet.chain.robinhood.com
ESCROW_ADDRESS=0x...
ESCROW_DEPLOY_BLOCK=0

# ── Keys (server only; never in the browser). Raw keys are refused on mainnet: use KMS (src/keys.ts).
OPERATOR_PRIVATE_KEY=0x...        # relayer: sends create/lock/result/finalize/refund txs, pays gas
COSIGNER_PRIVATE_KEY=0x...        # only in each co-signer process, one key per process

# ── Co-signers (m-of-n). Each on separate infra. Threshold is set on-chain.
COSIGNER_URLS=https://cosigner-a.internal:8701,https://cosigner-b.internal:8701
COSIGNER_AUTH_TOKEN=change-me

# ── Data
DATABASE_URL=postgres://etherroad@localhost:5432/etherroad
MATCH_DIRECTOR_URL=http://match-director.internal:8080
POLL_INTERVAL_MS=2000
INDEXER_LAG_BLOCKS=0
